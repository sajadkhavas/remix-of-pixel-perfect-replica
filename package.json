{
  "name": "tanstack_start_ts",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "packageManager": "bun@1.2.22",
  "engines": {
    "node": ">=22.12.0 <23",
    "bun": ">=1.2.22"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "node scripts/format-changed.mjs --write",
    "format:check": "node scripts/format-changed.mjs --check",
    "test": "bun run test:run",
    "test:unit": "bun test tests/server-error-page.smoke.test.ts tests/design-system.test.ts tests/quality/*.test.ts --bail",
    "test:contract": "bun test tests/commerce-persistence.test.ts tests/store-settings/*.test.ts tests/seo/*.test.ts --bail",
    "test:run": "bun run test:unit && bun run test:contract",
    "test:browser": "playwright test",
    "test:routes": "playwright test tests/browser/route-smoke.spec.ts --project=desktop-chromium --project=mobile-chromium",
    "test:a11y": "playwright test tests/browser/accessibility.spec.ts tests/browser/accessibility-fixtures.spec.ts --project=desktop-chromium --project=mobile-chromium",
    "test:reduced-motion": "playwright test tests/browser/reduced-motion.spec.ts --project=reduced-motion",
    "test:keyboard": "playwright test tests/browser/keyboard.spec.ts --project=keyboard-only",
    "quality:lint": "node scripts/quality/lint-governance.mjs",
    "quality:forbidden-copy": "node scripts/quality/forbidden-copy.mjs",
    "quality:links": "node scripts/quality/link-integrity.mjs",
    "quality:assets": "node scripts/quality/asset-validation.mjs",
    "quality:assets:release": "node scripts/quality/asset-validation.mjs --release",
    "quality:performance": "node scripts/performance/check-budget.mjs",
    "quality:summary": "node scripts/quality/report-summary.mjs --check",
    "quality:scanners": "bun run quality:forbidden-copy && bun run quality:links && bun run quality:assets && bun run quality:summary",
    "quality": "bun run format:check && bun run quality:lint && bun run typecheck && bun run test:run && bun run quality:scanners && bun run build && bun run quality:performance"
  },
